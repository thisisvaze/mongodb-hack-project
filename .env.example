# Copy this file to .env and fill in real values. .env is ignored by git.

# MongoDB Atlas: Cluster0 → Connect → Drivers. Paste the full string.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.<code>.mongodb.net/
DB_NAME=hackathon

# Voyage embeddings, served through MongoDB Atlas
VOYAGE_API_KEY=
VOYAGE_API_BASE=https://ai.mongodb.com/v1

# Per-teammate Voyage keys (optional)
VOYAGE_API_KEY_D=
VOYAGE_API_KEY_U=
VOYAGE_API_KEY_A=

# Backup of the Atlas model API key (endpoint https://ai.mongodb.com/v1)
ATLAS_MODEL_API_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-carbon

# ElevenLabs (not used yet)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
